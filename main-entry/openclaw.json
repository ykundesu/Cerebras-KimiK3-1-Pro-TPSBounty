{
  "gateway": {
    "mode": "local",
    "port": 18799,
    "bind": "loopback",
    "controlUi": {
      "sessionObserver": false
    }
  },
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "off",
      "userTimezone": "UTC",
      "skipBootstrap": false,
      "skipOptionalBootstrapFiles": ["SOUL.md", "USER.md", "HEARTBEAT.md", "IDENTITY.md"],
      "contextInjection": "always",
      "startupContext": {
        "enabled": false
      },
      "experimental": {
        "localModelLean": false
      },
      "models": {
        "cerebras/moonshotai-kimi-k3.1-pro-trial": {
          "params": {
            "temperature": 0,
            "maxTokens": 800,
            "parallel_tool_calls": true,
            "streaming": false,
            "extraBody": {
              "reasoning_effort": "low",
              "prompt_cache_key": "santa-short-pv"
            }
          }
        }
      },
      "heartbeat": {
        "every": "24h"
      }
    }
  },
  "skills": {
    "limits": {
      "maxSkillsInPrompt": 0
    }
  },
  "tools": {
    "toolSearch": false,
    "codeMode": false,
    "allow": [
      "exec"
    ],
    "exec": {
      "host": "gateway",
      "mode": "full"
    }
  },
  "plugins": {
    "allow": [
      "cerebras"
    ],
    "slots": {
      "memory": "none"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsUsageInStreaming": true,
              "requiresReasoningContentOnAssistantMessages": false,
              "unsupportedToolSchemaKeywords": ["description", "maxLength", "patternProperties"]
            },
            "maxTokens": 800,
            "contextWindow": 262144
          }
        ]
      }
    }
  }
}
