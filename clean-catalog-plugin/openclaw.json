{
  "gateway": {
    "mode": "local",
    "port": 18799,
    "bind": "loopback",
    "controlUi": {
      "sessionObserver": false
    }
  },
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": {
        "primary": "cerebras-clean/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low",
      "userTimezone": "UTC",
      "skipBootstrap": true,
      "contextInjection": "never",
      "startupContext": {
        "enabled": false
      },
      "experimental": {
        "localModelLean": false
      },
      "models": {
        "cerebras-clean/moonshotai-kimi-k3.1-pro-trial": {
          "params": {
            "temperature": 0,
            "maxTokens": 512,
            "parallel_tool_calls": true,
            "streaming": true
          }
        }
      },
      "heartbeat": {
        "every": "24h"
      }
    }
  },
  "skills": {
    "limits": {
      "maxSkillsInPrompt": 0
    }
  },
  "tools": {
    "toolSearch": false,
    "codeMode": false,
    "allow": [
      "search_catalog"
    ]
  },
  "plugins": {
    "allow": [
      "santa-catalog-clean",
      "cerebras"
    ],
    "load": {
      "paths": [
        "./plugins/santa-catalog-clean"
      ]
    },
    "slots": {
      "memory": "none"
    },
    "entries": {
      "santa-catalog-clean": {
        "enabled": true,
        "hooks": {
          "allowPromptInjection": true,
          "allowConversationAccess": true
        }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras-clean": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsUsageInStreaming": true,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": ["low", "high", "max"]
            },
            "maxTokens": 512,
            "contextWindow": 262144
          }
        ]
      }
    }
  }
}
